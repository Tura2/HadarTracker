# Telegram bot credentials (required) — no defaults, load_config() raises without them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional overrides (defaults shown).
DB_PATH=data/hadar.sqlite3
IMAGES_DIR=data/images
USER_ID=5609
FORUM_ID=1

# Optional: LLM trade-signal classification (Phase 2). If OPENROUTER_API_KEY
# is unset, classification is simply skipped (signal=None) — every post
# still gets scraped, stored, and notified exactly as in Phase 1.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Optional: used instead of OPENROUTER_MODEL only for posts with an attached
# image, for when OPENROUTER_MODEL is a text-only model (e.g. DeepSeek's v4
# family has no image input modality on OpenRouter). Leave unset to always
# use OPENROUTER_MODEL regardless of images.
OPENROUTER_VISION_MODEL=
